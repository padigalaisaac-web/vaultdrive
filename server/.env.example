PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaultdrive
JWT_SECRET=vaultdrive_super_secure_jwt_secret_key_2026_dev
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=5368709120
DEFAULT_USER_QUOTA_BYTES=10737418240

# S3 Configuration (Used if STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=vaultdrive-storage
